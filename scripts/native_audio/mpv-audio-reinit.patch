From a7f6460e7eb5995704c8940092c411feb6038932 Mon Sep 17 00:00:00 2001
From: Dudemanguy <random342@airmail.com>
Date: Tue, 10 Dec 2024 11:35:35 -0600
Subject: [PATCH] player/audio: get rid of bogus early return in reinit_audio_filters

Fixes #15477.
---
 player/audio.c | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/player/audio.c b/player/audio.c
index e86547c30e520..a5606d5e48a31 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -392,8 +392,3 @@ static int reinit_audio_filters_and_output(struct MPContext *mpctx)
-    // Wait until all played.
-    if (mpctx->ao && ao_is_playing(mpctx->ao)) {
-        talloc_free(out_fmt);
-        return 0;
-    }
     // Format change during syncing. Force playback start early, then wait.
     if (ao_c->ao_queue && mp_async_queue_get_frames(ao_c->ao_queue) &&
         mpctx->audio_status == STATUS_SYNCING)
