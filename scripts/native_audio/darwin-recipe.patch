diff --git a/scripts/libplacebo/build.sh b/scripts/libplacebo/build.sh
new file mode 100644
index 0000000..3a256c7
--- /dev/null
+++ b/scripts/libplacebo/build.sh
@@ -0,0 +1,71 @@
+#!/bin/sh
+
+set -e # exit immediately if a command exits with a non-zero status
+set -u # treat unset variables as an error
+
+cd "${SRC_DIR}"
+for dependency in fast_float glad jinja markupsafe vulkan-headers; do
+    archive=''
+    for candidate in "${PROJECT_DIR}/${DOWNLOADS_DIR}/libplacebo-${dependency}-"*.tar.gz; do
+        [ -f "${candidate}" ] || continue
+        archive=${candidate}
+        break
+    done
+    [ -n "${archive}" ]
+    subproject=${dependency}
+    if [ "${dependency}" = vulkan-headers ]; then
+        subproject=Vulkan-Headers
+    fi
+    mkdir -p "3rdparty/${subproject}"
+    tar -xzf "${archive}" --strip-components 1 -C "3rdparty/${subproject}"
+done
+
+cross_file="${PROJECT_DIR}/cross-files/${OS}-${ARCH}.ini"
+target_cross_file="${SRC_DIR}/darwin-cross-file.ini"
+case "${OS}" in
+    macos)
+        source_minimum='-mmacosx-version-min=10.9'
+        sed_expression='s/-mmacosx-version-min=10[.]9/-mmacosx-version-min=10.15/g'
+        ;;
+    ios)
+        source_minimum='-miphoneos-version-min=9.0'
+        sed_expression='s/-miphoneos-version-min=9[.]0/-miphoneos-version-min=13.0/g'
+        ;;
+    iossimulator)
+        if grep -Fq -- '-mios-simulator-version-min=12.0' "${cross_file}"; then
+            source_minimum='-mios-simulator-version-min=12.0'
+            sed_expression='s/-mios-simulator-version-min=12[.]0/-mios-simulator-version-min=13.0/g'
+        else
+            source_minimum='-mios-simulator-version-min=9.0'
+            sed_expression='s/-mios-simulator-version-min=9[.]0/-mios-simulator-version-min=13.0/g'
+        fi
+        ;;
+    *)
+        echo "Unsupported libplacebo target OS: ${OS}" >&2
+        exit 1
+        ;;
+esac
+grep -Fq -- "${source_minimum}" "${cross_file}"
+sed "${sed_expression}" "${cross_file}" > "${target_cross_file}"
+
+git -C "${PROJECT_DIR}" apply --directory="${SRC_DIR#${PROJECT_DIR}/}" "${PROJECT_DIR}/patches/libplacebo-darwin-charconv.patch"
+
+meson setup build \
+    --cross-file "${target_cross_file}" \
+    --prefix="${OUTPUT_DIR}" \
+    -Ddefault_library=static \
+    -Dopengl=enabled \
+    -Dvulkan=disabled \
+    -Dglslang=disabled \
+    -Dshaderc=disabled \
+    -Dlcms=disabled \
+    -Ddovi=disabled \
+    -Dlibdovi=disabled \
+    -Dunwind=disabled \
+    -Dxxhash=disabled \
+    -Ddemos=false \
+    -Dtests=false \
+    -Dbench=false \
+    -Dfuzz=false
+meson compile -C build
+meson install -C build
