+#if defined(__APPLE__)
+static int verify_peer_with_system_trust(URLContext *h)
+{
+    TLSContext *tls_ctx = h->priv_data;
+    TLSShared *shr = &tls_ctx->tls_shared;
+    const mbedtls_x509_crt *peer_cert = mbedtls_ssl_get_peer_cert(&tls_ctx->ssl_context);
+    CFMutableArrayRef certificates = NULL;
+    CFStringRef peer_name = NULL;
+    SecPolicyRef policy = NULL;
+    SecTrustRef trust = NULL;
+    int ret = AVERROR(EIO);
+
+    if (!peer_cert || !shr->host) {
+        av_log(h, AV_LOG_ERROR, "Mbed TLS did not retain the peer certificate chain or hostname\n");
+        return ret;
+    }
+    if (!(certificates = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    for (; peer_cert; peer_cert = peer_cert->next) {
+        CFDataRef data = CFDataCreate(NULL, peer_cert->raw.p, (CFIndex)peer_cert->raw.len);
+        SecCertificateRef certificate;
+        if (!data) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        certificate = SecCertificateCreateWithData(NULL, data);
+        CFRelease(data);
+        if (!certificate) {
+            av_log(h, AV_LOG_ERROR, "Unable to convert peer certificate for system trust\n");
+            goto end;
+        }
+        CFArrayAppendValue(certificates, certificate);
+        CFRelease(certificate);
+    }
+    if (!(peer_name = CFStringCreateWithCString(NULL, shr->host, kCFStringEncodingUTF8))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    if (!(policy = SecPolicyCreateSSL(true, peer_name))) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    if (SecTrustCreateWithCertificates(certificates, policy, &trust) != errSecSuccess) {
+        av_log(h, AV_LOG_ERROR, "Unable to create system trust evaluation\n");
+        goto end;
+    }
+    if (__builtin_available(macOS 10.14, iOS 12.0, *)) {
+        if (!SecTrustEvaluateWithError(trust, NULL)) {
+            av_log(h, AV_LOG_ERROR, "Peer certificate chain failed system trust evaluation\n");
+            goto end;
+        }
+    } else {
+        av_log(h, AV_LOG_ERROR, "System trust evaluation is unavailable on this OS version\n");
+        goto end;
+    }
+    ret = 0;
+end:
+    if (trust)
+        CFRelease(trust);
+    if (policy)
+        CFRelease(policy);
+    if (peer_name)
+        CFRelease(peer_name);
+    if (certificates)
+        CFRelease(certificates);
+    return ret;
+}
+#endif
